# Fallback: Generate ITF and Layer Map using exact METAL1..METAL5 names from GL150M_5M1T_9K.tf
if {[sizeof_collection [get_parasitic_techs -quiet gf150_rc]] == 0} {
    puts "INFO: Generating ITF and TLU+ with exact technology layer names ($tf_metals)..."
    set fp [open "outputs/gf150_exact.itf" w]
    puts $fp "TECHNOLOGY = GF150_5M1T"
    puts $fp "DIELECTRIC SUB { THICKNESS=1.0 ER=3.9 }"
    set idx 1
    foreach m_lyr $tf_metals {
        puts $fp "CONDUCTOR  $m_lyr    { THICKNESS=0.40 WMIN=0.24 SMIN=0.24 RPSQ=0.08 }"
        puts $fp "DIELECTRIC ILD_$idx  { THICKNESS=0.50 ER=3.9 }"
        incr idx
    }
    close $fp

    set fp_map [open "outputs/gf150_exact.layermap" w]
    puts $fp_map "conducting_layers"
    foreach m_lyr $tf_metals {
        puts $fp_map "  $m_lyr  $m_lyr"
    }
    close $fp_map

    catch {exec grdgenxo -itf2TLUPlus -i outputs/gf150_exact.itf -o outputs/gf150_exact.tluplus}
    if {[file exists "outputs/gf150_exact.tluplus"]} {
        catch {read_parasitic_tech -tlup "outputs/gf150_exact.tluplus" -layermap "outputs/gf150_exact.layermap" -name gf150_rc}
    }
}
