# 5. Build Exact METAL1-METAL5 Layer Map for TLU+ / Parasitic Extractor
set tlup_list {}
set map_list  {}
catch {
    set find_tlup [exec find $env(HOME)/RISCV/PlaceRoute $env(HOME)/RISCV/M31 -type f \( -iname "*5M1T*.tluplus" -o -iname "*5M1T*.tlup" -o -iname "*.tluplus" -o -iname "*.tlup" \)]
    set tlup_list [split [string trim $find_tlup] "\n"]
}
0
catch {
    set find_map [exec find $env(HOME)/RISCV/PlaceRoute $env(HOME)/RISCV/M31 -type f \( -iname "*5M1T*.map" -o -iname "*.map" -o -iname "*layermap*" \)]
    set map_list [split [string trim $find_map] "\n"]
}
0
if {[llength $tlup_list] > 0 && [lindex $tlup_list 0] ne ""} {
    set TLUP_FILE [lindex $tlup_list 0]
    puts "INFO: Found TLU+ file: $TLUP_FILE"

    # If a foundry .map file exists, remap its first column to METAL1..METAL5 from GL150M_5M1T_9K.tf
    if {[llength $map_list] > 0 && [lindex $map_list 0] ne ""} {
        set MAP_FILE [lindex $map_list 0]
        set tlup_conds {}
        set in_cond 0
        set fp_in [open $MAP_FILE r]
        while {[gets $fp_in line] >= 0} {
            set sline [string trim $line]
            if {$sline eq "" || [string match "#*" $sline] || [string match "//*" $sline]} { continue }
            if {[regexp -nocase {^conducting_layers} $sline]} { set in_cond 1; continue }
            if {[regexp -nocase {^(via_layers|marker_layers)} $sline]} { set in_cond 0; continue }
            if {$in_cond && [llength $sline] >= 2} {
                set c_name [lindex $sline 1]
                if {![string match -nocase "*poly*" $c_name]} {
                    lappend tlup_conds $c_name
                }
            }
        }
        close $fp_in

        if {[llength $tlup_conds] > 0 && [llength $tf_metals] > 0} {
            set fp_out [open "outputs/gf150_metal_matched.layermap" w]
            puts $fp_out "conducting_layers"
            set n [expr {min([llength $tf_metals], [llength $tlup_conds])}]
            for {set i 0} {$i < $n} {incr i} {
                puts $fp_out "  [lindex $tf_metals $i]  [lindex $tlup_conds $i]"
            }
            close $fp_out
            catch {read_parasitic_tech -tlup $TLUP_FILE -layermap "outputs/gf150_metal_matched.layermap" -name gf150_rc}
        }
    }
}
