# Load GlobalFoundries 150MCU TLU+ parasitics if available
set tlup_files [glob -nocomplain "$env(HOME)/RISCV/PlaceRoute/*/*.tluplus" "$env(HOME)/RISCV/PlaceRoute/*/*/*.tluplus" "$env(HOME)/RISCV/PlaceRoute/*.tluplus"]
set map_files  [glob -nocomplain "$env(HOME)/RISCV/PlaceRoute/*/*.map"     "$env(HOME)/RISCV/PlaceRoute/*/*/*.map"     "$env(HOME)/RISCV/PlaceRoute/*.map"]
if {[llength $tlup_files] > 0 && [llength $map_files] > 0} {
    puts "INFO: Loading GlobalFoundries 150MCU TLU+ RC model..."
    catch {
        read_parasitic_tech -tlup [lindex $tlup_files 0] -layermap [lindex $map_files 0] -name gf150_rc
        set_parasitic_parameters -early_spec gf150_rc -late_spec gf150_rc
    }
}
# 3. Power & Ground (VDD/VSS) connection procedure
proc conectar_pg {} {
    if {[sizeof_collection [get_nets -quiet VDD]] == 0} { create_net -power VDD }
    if {[sizeof_collection [get_nets -quiet VSS]] == 0} { create_net -ground VSS }

    set pwr_pins [get_pins -quiet -physical_context -filter "port_type == power"]
    set gnd_pins [get_pins -quiet -physical_context -filter "port_type == ground"]

    if {[sizeof_collection $pwr_pins] > 0} { catch {connect_pg_net -net VDD $pwr_pins} }
    if {[sizeof_collection $gnd_pins] > 0} { catch {connect_pg_net -net VSS $gnd_pins} }
    catch {connect_pg_net -automatic}
}
