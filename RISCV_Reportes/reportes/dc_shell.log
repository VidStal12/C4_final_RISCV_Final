# 3. Detectar automáticamente el nombre del módulo Top en Top_RISCV.sv
set TOP_MODULE "Top_RISCV"
Top_RISCV
set fp [open "Top_RISCV.sv" r]
file15
while {[gets $fp line] >= 0} {
    if {[regexp {^\s*module\s+([a-zA-Z0-9_]+)} $line -> mod_name]} {
        set TOP_MODULE $mod_name
        break
    }
}
close $fp
# 4. Elaborar, enlazar y crear copias únicas de submódulos parametrizados
elaborate $TOP_MODULE -work WORK
